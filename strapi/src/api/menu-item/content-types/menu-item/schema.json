{
  "kind": "collectionType",
  "collectionName": "menu_items",
  "info": {
    "singularName": "menu-item",
    "pluralName": "menu-items",
    "displayName": "Menu Item"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "seasonal": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "availableUntil": {
      "type": "date",
      "conditions": {
        "visible": {
          "==": [
            {
              "var": "seasonal"
            },
            true
          ]
        }
      },
      "required": true
    },
    "ingredients": {
      "type": "component",
      "component": "product.ingredient",
      "repeatable": true,
      "required": true
    },
    "price": {
      "type": "decimal",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "school": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::school.school",
      "inversedBy": "menu_items"
    }
  }
}
