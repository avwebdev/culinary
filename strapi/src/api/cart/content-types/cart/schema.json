{
  "kind": "collectionType",
  "collectionName": "carts",
  "info": {
    "singularName": "cart",
    "pluralName": "carts",
    "displayName": "Order"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "lines": {
      "type": "component",
      "component": "product.item-uuid",
      "repeatable": true,
      "required": true
    },
    "userEmail": {
      "type": "email",
      "required": true
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "completed"
      ],
      "default": "pending",
      "required": true
    },
    "school": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::school.school"
    },
    "approvedBy": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "admin::user"
    },
    "approvedAt": {
      "type": "datetime"
    },
    "rejectionReason": {
      "type": "text"
    },
    "deliveryDate": {
      "type": "date",
      "required": true
    }
  }
}
